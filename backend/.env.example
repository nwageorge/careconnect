# Copy to backend/.env and fill in.
MONGO_URL=mongodb://localhost:27017
DB_NAME=voallen

# Required in production: a long random string used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated emails with admin access (adds an Admin tab to their dashboard).
ADMIN_EMAILS=

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Load the 22 sample agencies on startup when the database is empty (true/false).
SEED_SAMPLE_DATA=true

# Booking emails. Leave SMTP_HOST empty to just log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Voallen <no-reply@voallen.com>
